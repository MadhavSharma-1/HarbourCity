# Which brain answers NPCs: "anthropic" (Claude API), "ollama" (local model), or "rules" (no LLM; the game uses its own grounded rules)
NEON_PROVIDER=anthropic
# Claude API key - keep it here on the server side, never in the game client
ANTHROPIC_API_KEY=
NEON_ANTHROPIC_MODEL=claude-opus-5-5
NEON_EFFORT=low
# Local model via Ollama (https://ollama.com) - runs well on Apple Silicon Macs
NEON_OLLAMA_URL=http://127.0.0.1:11434
NEON_OLLAMA_MODEL=llama3.1:8b
NEON_DB_PATH=neon_memory.db
NEON_PORT=8787
